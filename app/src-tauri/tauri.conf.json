{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparring",
  "version": "0.1.0",
  "identifier": "dev.sparring.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sparring",
        "width": 1100,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../core": "core",
      "../../server": "server",
      "../../lesson": "lesson",
      "../../survey": "survey",
      "../../skill": "skill"
    }
  }
}
